# Generated by frostfire: no TLS certificate yet, so only ACME challenges are served.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /srv/acme;
    }

    location / {
        default_type text/plain;
        return 503 "FrostFire is running, but ${DOMAIN} has no TLS certificate yet. Run: frostfire certs issue\n";
    }
}
