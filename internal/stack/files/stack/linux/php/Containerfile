FROM docker.io/library/php:8.4-fpm-alpine

COPY --from=docker.io/mlocati/php-extension-installer:latest /usr/bin/install-php-extensions /usr/local/bin/

# xml/dom/simplexml ship with the base image. msmtp replaces postfix for outbound mail.
RUN install-php-extensions mysqli pdo_mysql memcached opcache \
 && apk add --no-cache msmtp

COPY entrypoint.sh /usr/local/bin/frostfire-entrypoint
RUN chmod 0755 /usr/local/bin/frostfire-entrypoint

ENTRYPOINT ["frostfire-entrypoint"]
CMD ["php-fpm"]
