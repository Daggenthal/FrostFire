# Generated by frostfire. nginx on FreeBSD. envsubst comes from gettext-runtime.
ARG FREEBSD_VERSION=15.0
FROM docker.io/freebsd/freebsd-runtime:${FREEBSD_VERSION}

RUN env ASSUME_ALWAYS_YES=yes pkg bootstrap -f \
 && pkg install -y nginx gettext-runtime \
 && pkg clean -ay \
 && rm -rf /var/db/pkg/repos/*

COPY nginx.conf /usr/local/etc/nginx/nginx.conf
COPY entrypoint.sh /usr/local/bin/frostfire-entrypoint
RUN chmod 0755 /usr/local/bin/frostfire-entrypoint

EXPOSE 80 443
ENTRYPOINT ["/usr/local/bin/frostfire-entrypoint"]
