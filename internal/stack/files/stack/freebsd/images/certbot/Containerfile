# Generated by frostfire. certbot on FreeBSD. Installed by port origin so the current
# Python flavor (py311, py312, ...) is picked automatically.
ARG FREEBSD_VERSION=15.0
FROM docker.io/freebsd/freebsd-runtime:${FREEBSD_VERSION}

RUN env ASSUME_ALWAYS_YES=yes pkg bootstrap -f \
 && pkg install -y security/py-certbot \
 && pkg clean -ay \
 && rm -rf /var/db/pkg/repos/*

# FreeBSD's certbot defaults to /usr/local/etc/letsencrypt. Point it at the same
# path the Linux image uses, so certs and backups are identical on both.
RUN rm -rf /usr/local/etc/letsencrypt \
 && ln -s /etc/letsencrypt /usr/local/etc/letsencrypt

ENTRYPOINT ["certbot"]
