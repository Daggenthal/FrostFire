# FrostFire settings. Keep this file mode 600: it holds every secret for the stack.
# Values containing $ must be wrapped in single quotes.

# Site
DOMAIN=example.com
# Extra names for the certificate, comma separated (optional)
CERT_EXTRA_DOMAINS=www.example.com
ADMIN_EMAIL=you@example.com

# MariaDB
MARIADB_ROOT_PASSWORD=__GENERATED__
MEMCACHED_MB=128

# Outbound mail (SendGrid: user is literally "apikey", password is the API key)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Backups (restic). Example: the Pi 5 over SFTP, using root's SSH key on this server.
RESTIC_REPOSITORY=sftp:backup@pi5.lan:/srv/restic/frostfire
# Store this password somewhere else too (password manager). Without it the backups are unreadable.
RESTIC_PASSWORD=__GENERATED__

# Retention for `frostfire prune`
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# Optional overrides
# FROSTFIRE_ENGINE=podman
# RESTIC_BIN=/usr/local/bin/restic
