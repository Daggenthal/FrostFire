# Generated by frostfire. PHP 8.4 FPM on FreeBSD, with the same extensions as the Linux image.
FROM localhost/frostfire-base:latest

RUN pkg install -y php84 php84-extensions php84-mysqli php84-pdo_mysql php84-pecl-memcached \
        php84-mbstring php84-curl php84-zlib php84-fileinfo php84-sodium php84-opcache \
        msmtp ca_root_nss \
 && pkg clean -ay

# Production php.ini, FPM in the foreground listening for nginx on port 9000, logs to stderr.
# msmtp is linked to /usr/bin/msmtp so frostfire.ini works unchanged on both OSes.
RUN cp /usr/local/etc/php.ini-production /usr/local/etc/php.ini \
 && printf '%s\n' '[global]' 'daemonize = no' 'error_log = /dev/stderr' \
        '[www]' 'listen = 9000' 'access.log = /dev/stderr' \
        'catch_workers_output = yes' 'decorate_workers_output = no' \
        > /usr/local/etc/php-fpm.d/zz-frostfire.conf \
 && ln -sf /usr/local/bin/msmtp /usr/bin/msmtp

ENV MSMTPRC=/usr/local/etc/msmtprc \
    MAIL_GROUP=www \
    TLS_TRUST_FILE=/usr/local/share/certs/ca-root-nss.crt

COPY entrypoint.sh /usr/local/bin/frostfire-entrypoint
RUN chmod 0755 /usr/local/bin/frostfire-entrypoint

EXPOSE 9000
ENTRYPOINT ["/usr/local/bin/frostfire-entrypoint"]
CMD ["/usr/local/sbin/php-fpm"]
